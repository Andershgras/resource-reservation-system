# Settings for compose.yaml. Copy to .env, which git ignores, and fill in the
# secrets. Never commit .env.
#
# Generate each secret separately, for example with: openssl rand -base64 24
# Passwords must not contain ' ; " or $, which would break the connection
# strings or the compose file.

# The address people open in the browser, used for redirects and email links.
PUBLIC_ORIGIN=https://localhost:8443

# Secrets
# SQL Server's sa password, used by the migrator and to create the API's login.
# SQL Server needs 8+ characters with three of: upper case, lower case, digits, symbols.
MSSQL_SA_PASSWORD=
# The API's own SQL login, which can read and write data but not change the schema.
APP_DB_PASSWORD=
# Signs session tokens. At least 32 characters. Changing it ends every session.
JWT_KEY=

EMAIL_FROM_ADDRESS=no-reply@reservations.example.com

# The SMTP server that sends the emails. Always over TLS: StartTls (usually
# port 587) or SslOnConnect (usually port 465). Locally, compose.mailpit.yaml
# replaces these with Mailpit, so they can stay empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
# Secret
SMTP_PASSWORD=

# Optional: creates the first admin when no admin exists. Remove both after the
# first sign-in and change that admin's password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Published ports. 127.0.0.1 keeps the site on this machine. On a server, use
# 0.0.0.0 with ports 80 and 443.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# The folder with tls.crt and tls.key. deploy/create-dev-certificate.sh
# creates a localhost certificate in ./certs.
TLS_CERT_DIR=./certs

# Optional
# MAILPIT_UI_PORT=8025
# MSSQL_PID=Express
# JWT_ISSUER=ResourceReservation.Api
# JWT_AUDIENCE=ResourceReservation.Client
# The private network between nginx and the API. If the subnet clashes with
# another network, change all three together: PROXY_IP is nginx's fixed
# address, inside the subnet but outside PROXY_IP_RANGE, which Docker uses for
# every other container.
# PROXY_SUBNET=172.31.250.0/24
# PROXY_IP_RANGE=172.31.250.128/25
# PROXY_IP=172.31.250.10
